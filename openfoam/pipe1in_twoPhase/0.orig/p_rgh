FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "inlet.*"
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    outlet
    {
        // Uniform static (gauge) pressure p = 0 at the outlet
        type            prghPressure;
        p               uniform 0;
        value           uniform 0;
    }
    wall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

